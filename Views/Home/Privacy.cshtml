@{
    ViewData["Title"] = "About";
}

<h1>About Favorite Games 🎮</h1>

<p class="lead">
    Favorite Games is a web application for exploring and
    managing a personal collection of video games.
</p>

<p>
    Browse games, view their details, and add your own favorites
    to the collection. You can also update existing entries,
    leave reviews, and keep track of the games you enjoy.
</p>

<h2>Built With</h2>

<p>
    This project was developed using ASP.NET Core MVC,
    C#, Entity Framework Core, and SQL Server.
</p>