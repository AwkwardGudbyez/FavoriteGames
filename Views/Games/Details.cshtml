@model Game

@{
    ViewData["Title"] = Model.Name;
}

<div class="card bg-dark border-secondary shadow-sm mb-4">
    <div class="card-body p-4">

        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
            <h1 class="fw-bold mb-0">🎮 @Model.Name</h1>

            @if (Model.Rating.HasValue)
            {
                <span class="badge bg-primary fs-5">
                    ⭐ @Model.Rating/10
                </span>
            }
            else
            {
                <span class="badge bg-secondary fs-6">
                    Not Rated
                </span>
            }
        </div>

        <hr />

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <p class="text-muted mb-1">Developer</p>
                <h5>@Model.Developer</h5>
            </div>

            <div class="col-md-4">
                <p class="text-muted mb-1">Genre</p>
                <h5>@Model.Genre</h5>
            </div>

            <div class="col-md-4">
                <p class="text-muted mb-1">Release Year</p>
                <h5>@Model.YearReleased</h5>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                ✏️ Edit Game
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-outline-danger">
                🗑️ Delete Game
            </a>

            <a asp-action="Index"
               class="btn btn-outline-light">
                Back to Games
            </a>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
    <h2 class="mb-0">⭐ Game Reviews</h2>

    <a asp-controller="GameReviews"
       asp-action="Create"
       class="btn btn-success">
        Write a Review
    </a>
</div>

@if (Model.Reviews.Any())
{
    @foreach (var review in Model.Reviews)
    {
        <div class="card bg-dark border-secondary mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-2">@review.ReviewerName</h5>

                    <span class="badge bg-primary">
                        ⭐ @review.Score/10
                    </span>
                </div>

                <p class="card-text mt-2 mb-0">
                    @review.Comment
                </p>
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-info">
        <h4>No reviews yet!</h4>
        <p>
            Nobody has reviewed this game yet.
            Be the first to share your thoughts!
        </p>

        <a asp-controller="GameReviews"
           asp-action="Create"
           class="btn btn-primary">
            Write the First Review
        </a>
    </div>
}